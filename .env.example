# Copy to .env and replace every value.
DOMAIN=vpn.example.com
# Certificate lineage directory under /etc/letsencrypt/live/
CERT_NAME=vpn.example.com
PROXY_USER=choose-a-unique-username
# Use a long password without whitespace or Caddyfile-special characters.
# Keep this file out of version control.
PROXY_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_SECRET
# Pin and test a specific Caddy version before production deployment.
CADDY_VERSION=2.10.2
